{
  "name": "flaha-inspect",
  "private": true,
  "version": "1.0.0",
  "description": "FlahaINSPECT monorepo — Node packages only; Flutter lives in apps/mobile",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20.11.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:infra": "node --test infra/compose-contract.test.mjs",
    "typecheck": "turbo run typecheck",
    "build": "turbo run build",
    "dev": "turbo run dev --filter=@flaha/inspect-api --filter=@flaha/inspect-web --filter=@flaha/inspect-worker"
  },
  "devDependencies": {
    "pnpm": "9.15.9",
    "turbo": "^2.5.5",
    "typescript": "^5.7.3"
  }
}
