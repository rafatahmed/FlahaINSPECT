{
  "name": "@flaha/inspect-api-client",
  "version": "0.0.0",
  "private": true,
  "description": "Typed FlahaINSPECT API client (hand-written from openapi/flaha-inspect-v1.yaml)",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "require": "./dist/index.js",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "node -e \"process.exit(0)\"",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node --test tests/exports.test.mjs"
  }
}
