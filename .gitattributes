# =============================================================================
# FlahaINSPECT — .gitattributes
# Consistent line endings, binary handling, and language stats
# =============================================================================

# Default: auto-detect text, normalize to LF in the repository
* text=auto eol=lf

# Explicit text types (LF in repo; checkout respects core.autocrlf / eol)
*.md          text eol=lf
*.txt         text eol=lf
*.json        text eol=lf
*.jsonc       text eol=lf
*.yml         text eol=lf
*.yaml        text eol=lf
*.toml        text eol=lf
*.xml         text eol=lf
*.svg         text eol=lf
*.html        text eol=lf
*.css         text eol=lf
*.scss        text eol=lf
*.less        text eol=lf
*.js          text eol=lf
*.jsx         text eol=lf
*.mjs         text eol=lf
*.cjs         text eol=lf
*.ts          text eol=lf
*.tsx         text eol=lf
*.mts         text eol=lf
*.cts         text eol=lf
*.dart        text eol=lf
*.graphql     text eol=lf
*.gql         text eol=lf
*.sql         text eol=lf
*.sh          text eol=lf
*.bash        text eol=lf
*.zsh         text eol=lf
*.ps1         text eol=lf
*.env.example text eol=lf
*.gitignore   text eol=lf
*.gitattributes text eol=lf
*.editorconfig text eol=lf
Makefile      text eol=lf
Dockerfile    text eol=lf
.dockerignore text eol=lf
*.dockerfile  text eol=lf
openapi/**    text eol=lf

# Windows scripts that should retain CRLF when checked out on Windows
*.bat         text eol=crlf
*.cmd         text eol=crlf

# Binary — do not touch
*.png         binary
*.jpg         binary
*.jpeg        binary
*.gif         binary
*.webp        binary
*.ico         binary
*.icns        binary
*.pdf         binary
*.zip         binary
*.gz          binary
*.7z          binary
*.rar         binary
*.woff        binary
*.woff2       binary
*.ttf         binary
*.otf         binary
*.eot         binary
*.mp4         binary
*.webm        binary
*.mp3         binary
*.wav         binary
*.mbtiles     binary
*.sqlite      binary
*.db          binary
*.p12         binary
*.pfx         binary
*.jks         binary
*.keystore    binary

# Git LFS (optional — enable with `git lfs install` if large binaries grow)
# Uncomment when adopting LFS for mockups or fixtures:
# *.psd filter=lfs diff=lfs merge=lfs -text
# Docs/Photo/**/*.jpg filter=lfs diff=lfs merge=lfs -text

# -----------------------------------------------------------------------------
# Linguist — keep GitHub language stats focused on product code
# -----------------------------------------------------------------------------
Docs/**       linguist-documentation
docs/**       linguist-documentation
*.md          linguist-documentation
openapi/**    linguist-generated
**/generated/** linguist-generated
**/*generated*  linguist-generated
pnpm-lock.yaml  linguist-generated
package-lock.json linguist-generated
yarn.lock       linguist-generated
**/Podfile.lock linguist-generated
**/pubspec.lock linguist-generated
