# FlahaINSPECT local / compose environment.
# Copy to `.env` (never commit `.env`). Values here are for development only.

# -----------------------------------------------------------------------------
# Postgres + PostGIS
# -----------------------------------------------------------------------------
POSTGRES_USER=flaha
POSTGRES_PASSWORD=flaha_dev_only
POSTGRES_DB=flaha_inspect
# Host port 5433 avoids a local Windows Postgres already bound to 5432.
POSTGRES_PORT=5433
DATABASE_URL=postgres://flaha:flaha_dev_only@localhost:5433/flaha_inspect

# -----------------------------------------------------------------------------
# MinIO (S3-compatible). Buckets are created private (no anonymous GET).
# -----------------------------------------------------------------------------
MINIO_ROOT_USER=flaha
MINIO_ROOT_PASSWORD=flaha_dev_only_minio
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
S3_BUCKET=flaha-inspect
S3_REGION=us-east-1
S3_FORCE_PATH_STYLE=true
# Inside compose, services use http://minio:9000. Host processes use localhost.
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=flaha
S3_SECRET_KEY=flaha_dev_only_minio

# -----------------------------------------------------------------------------
# tusd (upload endpoint published; hooks stay on the internal Docker network)
# -----------------------------------------------------------------------------
TUSD_PORT=1080
TUSD_PUBLIC_URL=http://localhost:1080/files/
TUSD_HOOK_SECRET=dev-tusd-hook-secret-change-me
TUSD_MAX_SIZE=26214400

# -----------------------------------------------------------------------------
# API / worker
# -----------------------------------------------------------------------------
API_PORT=3001
NODE_ENV=development

# Auth (PR-04)
JWT_ACCESS_SECRET=dev-jwt-access-change-me
JWT_REFRESH_SECRET=dev-jwt-refresh-change-me
MIN_APP_VERSION=0.0.1
CLIENT_ROLE_ENABLED=false
WEB_ORIGIN=http://localhost:3000

# PR-03 — local/staging seed only; never a production default.
# `make seed` refuses to run if this is empty or NODE_ENV=production.
SEED_PASSWORD=

# -----------------------------------------------------------------------------
# Maps (KD-35 / KD-43 / G-01)
# Pilot/prod: self-hosted TileServer GL (Qatar extract). Not public OSM.
# After `make tiles-prepare` and `make tiles-up`:
#   TILE_PROVIDER_URL=http://127.0.0.1:8082/styles/basic-preview/{z}/{x}/{y}.png
# Android emulator: http://10.0.2.2:8082/styles/basic-preview/{z}/{x}/{y}.png
# Leave empty only for local debug (ambient OSM, no bulk).
# -----------------------------------------------------------------------------
TILE_PROVIDER_URL=
TILE_PORT=8082
TILE_PROVIDER_ATTRIBUTION=© OpenStreetMap contributors
TILE_PROVIDER_USER_AGENT=FlahaINSPECT/1.0

# -----------------------------------------------------------------------------
# Feature flags + retention (PR-16). G-05 still open; 12 months is the default.
# -----------------------------------------------------------------------------
UPLOADS_ENABLED=true
PDF_ENABLED=true
RETENTION_ARCHIVE_MONTHS=12
TUSD_INCOMPLETE_HOURS=48
